{
  "name": "tdsf-terminal-agent",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "TDSF Terminal Agent v4.0 — 终端优先的 Linux 运维 AI 工作台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:web": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"docs/**/*.md\" \"specs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "cd python-sidecar && python -m pytest -v --tb=short",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:win": "tauri build"
  },
